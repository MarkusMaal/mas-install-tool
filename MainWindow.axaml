<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        CanResize="False" CanMinimize="False" CanMaximize="False"
        Width="659" Height="530" WindowStartupLocation="CenterScreen"
        x:Class="mas_install_tool.MainWindow" Icon="Resources\mas_general.png"
        Title="Markuse arvuti juurutamise tööriist" Closing="Window_OnClosing">
        <Grid>
            <Label VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   FontFamily="Segoe UI" FontSize="20"
                   Margin="90,0,0,38">
                markuse asjad
            </Label>
            <Label VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   FontFamily="Segoe UI" FontSize="11"
                   Margin="90,0,0,22">
                nullist juurutamise töörist
            </Label>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Orientation="Vertical">
                <Image Name="CenterImage" Width="128" Source="Resources/root_idc_search.png"
                       RenderOptions.BitmapInterpolationMode="HighQuality"></Image>
                <Label Name="CenterText" HorizontalContentAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe UI" FontSize="18">Teabe kogumine...</Label>
                <ProgressBar Margin="0, 10,0,0" Name="MidProgress" IsIndeterminate="True"></ProgressBar>
            </StackPanel>
            <TextBlock
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Width="255" Margin="0,0,10,20" TextWrapping="Wrap"
                FontSize="12" Name="NoticeText" IsVisible="False">
                Juurutamise protsess võib kaua aega võtta.<LineBreak/>
                Ärge lülitage protsessi käigus käsitsi arvutit välja!
            </TextBlock>
            <Label FontFamily="Segoe UI"
                   Margin="9, 9, 0, 0"
                   FontSize="18">Etapp 1: Teabe kogumine</Label>
            <Image Source="Resources/mas_general.png" Width="64"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   Margin="12,0,0,12"></Image>
            
        </Grid>
</Window>
